{
  "id": "witwin.channel",
  "name": "Channel (Radiomap)",
  "version": "0.1.0",
  "author": "",
  "description": "Round-trips witwin.channel solver scenes <-> the studio editor (structures, endpoints, antenna arrays, ITU materials) and runs the deterministic and Monte Carlo solvers with 2D radiomap visualization.",
  "license": "GPL-3.0-or-later",
  "engines": { "witwin": "^1.0.0" },
  "dependencies": ["scipy", "numpy"],
  "contributes": {
    "solvers": [
      {
        "id": "witwin.channel.radiomap",
        "title": "Channel RadioMap",
        "entry": "solver_host.py",
        "runtime": { "python": "${env:WITWIN_CHANNEL_PYTHON}" },
        "lifecycle": "warm",
        "idleTimeoutSec": 300,
        "cancelGraceSec": 5,
        "maxParallel": 1,
        "capabilities": {
          "cancel": true,
          "partials": true,
          "query": ["extract_map"]
        }
      },
      {
        "id": "witwin.channel.path",
        "title": "Channel Path Solver",
        "entry": "solver_host.py",
        "runtime": { "python": "${env:WITWIN_CHANNEL_PYTHON}" },
        "lifecycle": "warm",
        "idleTimeoutSec": 300,
        "cancelGraceSec": 5,
        "maxParallel": 1,
        "capabilities": {
          "cancel": true,
          "partials": true,
          "query": ["plot", "ray_batch"]
        }
      }
    ]
  },
  "icon": "radio",
  "enabled": true
}
